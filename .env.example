APP_NAME=


SERVER_PORT=
CONTEXT_PATH=


# PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
FLYWAY_BASELINE_ON_MIGRATE=true

# Authentication
# Generate a random secret, then encode it as Base64. The decoded value must be at least 32 bytes.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=15m

PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Để trống khi chạy local không cần authentication.
REDIS_PASSWORD=

# Mail (Gmail SMTP)
# Dùng App Password 16 ký tự, KHÔNG dùng password Gmail thường
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# OTP
# Chuỗi bất kỳ, tối thiểu 32 ký tự, dùng để HMAC-SHA256 hash OTP
OTP_HMAC_SECRET=
