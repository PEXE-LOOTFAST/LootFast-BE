APP_NAME=lootfast-backend


SERVER_PORT=8080
CONTEXT_PATH=
# Exact frontend origins, separated by commas. Do not use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Keep API documentation enabled locally; set false in production.
SWAGGER_ENABLED=true
# SQL logging is useful while debugging locally but should stay off in production.
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false


# PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# Local Docker can disable TLS; use require/verify-full when the provider supports it.
DB_SSL_MODE=disable
# Enable only when adopting a non-empty database that predates Flyway.
FLYWAY_BASELINE_ON_MIGRATE=false

# Authentication
# Generate a random secret, then encode it as Base64. The decoded value must be at least 32 bytes.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=30d

PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Để trống khi chạy local không cần authentication.
REDIS_PASSWORD=

# Transactional email (Brevo REST API over HTTPS)
# API key thật chỉ được lưu trong .env local và secret manager của môi trường deploy.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=LootFast
# Giữ timeout ngắn để email provider không chiếm hết worker khi bị chậm.
BREVO_CONNECT_TIMEOUT=3s
BREVO_READ_TIMEOUT=10s

# OTP
# Chuỗi bất kỳ, tối thiểu 32 ký tự, dùng để HMAC-SHA256 hash OTP
OTP_HMAC_SECRET=

# Google ID token audiences, comma-separated. For Android Credential Manager use the
# Web OAuth client ID passed as serverClientId; the Android OAuth client identifies
# the APK by package + signing SHA-1. No Google client secret is needed for this flow.
# Setup and API test flow: docs/google-sign-in.md
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Cloudinary public images and private business-license images
# Lấy ba giá trị này từ Cloudinary Console; không commit API secret thật.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Premium VNPay checkout: sandbox only until verified IPN fulfillment is ready.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Fixed HTTPS destination; no query/fragment. Do not collect real payments yet.
VNPAY_RETURN_URL=

# Fixed frontend result page; leave empty to return JSON. Never use a client-provided URL.
VNPAY_FE_RESULT_URL=

# Enable only after VNPay sandbox credentials and server IP are configured.
VNPAY_QUERY_ENABLED=false
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_QUERY_IP=127.0.0.1

# Deal minh họa (không có thật) khi khu vực chưa có deal thật. true để bật, để trống = tắt.
DEMO_DEALS_ENABLED=
